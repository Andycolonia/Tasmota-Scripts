>D 40
factor=100
M:p:dcon=0 31
M:p:mcon=0 12
; ABRECHNUNGSDATEN von der Gasrechnung. Aenderung greift nach 60s.
; Brennwert in kWh/m3 (typisch 10.0 - 11.5)
bwert=11.0
; Zustandszahl / z-Zahl (typisch ca. 0.95)
zzahl=0.95
; Arbeitspreis in EUR pro kWh (0.12 = 12 Cent)
gpreis=0.12
GasTotal=0
p:mval=0
p:dval=0
p:yval=0
tmp=0
utm="00d 00h 00m"
hour=0
yr=0
da=1
save=0
smlj=0
kfak=10.45
pm3=1.254
m3t=0
m3m=0
m3j=0
kwt=0
kwm=0
kwj=0
kwg=0
eut=0
eum=0
euj=0
eug=0
>B
=>sensor53 r
; ANFANGSZAEHLERSTAND einmalig in der Console setzen, nicht hier:
;   sensor53 c1 123456   (Hundertstel m3, entspricht 1234,56 m3)
; Im Script wuerde er bei jedem Neustart neu gesetzt und der
; Verlauf in Home Assistant dadurch zerstoert.
smlj=0
kfak=bwert*zzahl
pm3=kfak*gpreis
>M 1
+1,14,c,1,-500,Gas
1,1-0:1.8.0*255(@%factor%,Gesamtverbrauch,m3,total,18)
#
>S
if (save==1) {
save=0
svars
}
if (sml[1]>0) {
smlj=1
}
if (year<2020) {
break
}
GasTotal=sml[1]
m3t=GasTotal-dval
m3m=GasTotal-mval
m3j=GasTotal-yval
if (upsecs%60==0) {
hour=hours
yr=year
utm=s(2.0(int(uptime/1440)))+"d "+s(2.0(int(uptime/60)%24))+"h "+s(2.0(uptime%60))+"m"
dcon[day]=m3t
mcon[month]=m3m
kfak=bwert*zzahl
pm3=kfak*gpreis
kwt=m3t*kfak
kwm=m3m*kfak
kwj=m3j*kfak
kwg=GasTotal*kfak
eut=kwt*gpreis
eum=kwm*gpreis
euj=kwj*gpreis
eug=kwg*gpreis
if ((chg[hour]>0) and (hour==0)) {
if (day>1) {
da=day
} else {
for tmp (da+1) 31 1
dcon[tmp]=0
next
mval=GasTotal
}
if (chg[yr]>0) {
yval=GasTotal
}
dval=GasTotal
svars
}
if (smlj>0) {
=>publish tele/%topic%/GAS_STATS {"m3_Tag":%2m3t%,"m3_Monat":%2m3m%,"m3_Jahr":%2m3j%,"m3_Gesamt":%2GasTotal%,"kWh_Tag":%2kwt%,"kWh_Monat":%2kwm%,"kWh_Jahr":%2kwj%,"kWh_Gesamt":%2kwg%}
=>publish tele/%topic%/GAS_COST {"EUR_Tag":%2eut%,"EUR_Monat":%2eum%,"EUR_Jahr":%2euj%,"EUR_Gesamt":%2eug%,"Preis_kWh":%3gpreis%,"Preis_m3":%3pm3%,"Brennwert":%2bwert%,"Zustandszahl":%2zzahl%}
}
}
>W
bu(save "gespeichert!" "Daten sofort speichern")
Tag{m}%2m3t% m3 - %2kwt% kWh - %2eut% EUR
Monat{m}%2m3m% m3 - %2kwm% kWh - %2eum% EUR
Jahr{m}%2m3j% m3 - %2kwj% kWh - %2euj% EUR
Gesamt{m}%2GasTotal% m3 - %2kwg% kWh - %2eug% EUR
Preis{m}%3gpreis% EUR/kWh - %3pm3% EUR/m3
Uptime{m}%utm%
