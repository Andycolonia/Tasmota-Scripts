>D 40
;*****
; Gaszähler - DMY + MQTT (Home Assistant tauglich)
;
; Chart Script by ottelo.jimdo.de - modified by Smart Solutions Westerwald
; MQTT-Ausgabe + Brennwert/Kosten ergaenzt
;*****
; - Haken bei "Skript aktivieren" setzen
; - Skript auswaehlen
; - Speichern anklicken
;*****
; Faktor
; 1 imp = 0,01 m3  =>  100
; 1 imp = 0,1 m3   =>  10
; 1 imp = 1,0 m3   =>  1
factor=100
; -- ARRAYS --
; Tagesverbrauch Tabelle 1-31
M:p:dcon=0 31
; Monatsverbrauch Tabelle 1-12
M:p:mcon=0 12
; -- VARS --
; Zaehlerstand [m3]
GasTotal=0
; Tages, Monats, Jahres Verbrauch
p:mval=0
p:dval=0
p:yval=0
tmp=0
utm="00d 00h 00m"
hour=0
yr=0
da=1
save=0
smlj=0
; >>> ABRECHNUNGSDATEN - alle Werte von der Gasrechnung <<<
; Gaspreis pro kWh in EUR (z.B. 0.12 = 12 Cent/kWh)
gpreis=0.12
; Brennwert in kWh/m3 (ca. 10.0 - 11.5)
brennwert=11.0
; Zustandszahl / z-Zahl (meist ca. 0.95)
zzahl=0.95
; -- BERECHNETE WERTE (nicht aendern) --
kfak=10.45
pm3=1.254
m3tag=0
m3monat=0
m3jahr=0
kwhtag=0
kwhmonat=0
kwhjahr=0
kwhges=0
eurtag=0
eurmonat=0
eurjahr=0
eurges=0
; -- BOOT --
>B
=>sensor53 r
; Deaktiviere MQTT beim Start, verhindert das falsche Werte gesendet werden
smlj=0
; Umrechnungsfaktoren einmalig berechnen
kfak=brennwert*zzahl
pm3=kfak*gpreis
; Anfangszaehlerstand: NICHT hier setzen!
; Diese Zeile wuerde den Zaehler bei JEDEM Neustart zuruecksetzen und in
; Home Assistant den Verlauf zerstoeren. Anfangsstand einmalig ueber die
; Console setzen:  sensor53 c1 123456   (Hundertstel, = 1234,56 m3)
; =>sensor53 c1 0
;-- SML --
>M 1
; Setupline
+1,0,c,1,-500,Gas
1,1-0:1.8.0*255(@%factor%,Gesamtverbrauch,m3,total,18)
#
; -- JEDE SEKUNDE --
>S
if (save==1) {
save=0
svars
print Daten wurden gespeichert
}
; Start MQTT erst wenn Daten vom Zaehler kommen
if (sml[1]>0) {
smlj=1
}
; Warte auf NTP
if (year<2020) {
print NTP not ready
break
}
; kopiere Zaehlerstand [m3] vom Zaehler (aus SML Variable)
GasTotal=sml[1]
; Verbrauch [m3]
m3tag=GasTotal-dval
m3monat=GasTotal-mval
m3jahr=GasTotal-yval
; alle 60s
if (upsecs%60==0) {
hour=hours
yr=year
; Zeit seit letztem Boot
utm=s(2.0(int(uptime/1440)))+"d "+s(2.0(int(uptime/60)%24))+"h "+s(2.0(uptime%60))+"m"
; Tagesverbrauch [m3]
dcon[day]=m3tag
; Monatsverbrauch [m3]
mcon[month]=m3monat
; Energie [kWh] = m3 * Brennwert * Zustandszahl
kwhtag=m3tag*kfak
kwhmonat=m3monat*kfak
kwhjahr=m3jahr*kfak
kwhges=GasTotal*kfak
; Kosten [EUR] = kWh * Preis pro kWh
eurtag=kwhtag*gpreis
eurmonat=kwhmonat*gpreis
eurjahr=kwhjahr*gpreis
eurges=kwhges*gpreis
; Berechnung um Mitternacht
if ((chg[hour]>0) and (hour==0)) {
if (day>1) {
da=day
} else {
; Monatswechsel
for tmp (da+1) 31 1
dcon[tmp]=0
next
; monthly values
mval=GasTotal
}
if (chg[yr]>0) {
; Jahreswechsel
yval=GasTotal
}
; daily values
dval=GasTotal
; nur 1x um Mitternacht speichern
svars
}
; MQTT nur senden wenn der Zaehler schon Daten geliefert hat
if (smlj>0) {
=>publish tele/%topic%/GAS_STATS {"m3_Tag":%2m3tag%,"m3_Monat":%2m3monat%,"m3_Jahr":%2m3jahr%,"m3_Gesamt":%2GasTotal%,"kWh_Tag":%2kwhtag%,"kWh_Monat":%2kwhmonat%,"kWh_Jahr":%2kwhjahr%,"kWh_Gesamt":%2kwhges%}
=>publish tele/%topic%/GAS_COST {"EUR_Tag":%2eurtag%,"EUR_Monat":%2eurmonat%,"EUR_Jahr":%2eurjahr%,"EUR_Gesamt":%2eurges%,"Preis_kWh":%3gpreis%,"Preis_m3":%3pm3%,"Brennwert":%2brennwert%,"Zustandszahl":%2zzahl%}
}
}
; WEB INTERFACE
>W
; web button
bu(save "gespeichert!" "Daten sofort speichern")
; Verbrauch
Tagesverbrauch{m}%2m3tag% m3
Monatsverbrauch{m}%2m3monat% m3
Jahresverbrauch{m}%2m3jahr% m3
Gesamtverbrauch{m}%2GasTotal% m3
; Energie (kWh = m3 * Brennwert * Zustandszahl)
Tagesverbrauch{m}%2kwhtag% kWh
Monatsverbrauch{m}%2kwhmonat% kWh
Jahresverbrauch{m}%2kwhjahr% kWh
; Kosten (kWh * Preis pro kWh)
Gaspreis{m}%3gpreis% EUR/kWh - %3pm3% EUR/m3
Tageskosten{m}%2eurtag% EUR
Monatskosten{m}%2eurmonat% EUR
Jahreskosten{m}%2eurjahr% EUR
Gesamtkosten{m}%2eurges% EUR
; Zeit
Datum{m}%s(2.0day)%.%s(2.0month)%.%s(2.0year)% - %s(2.0hours)%:%s(2.0mins)%:%s(2.0secs)%
Uptime{m}%utm%
